// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  faculty
  admin
}

enum LoginStatus {
  SUCCESS
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionTaken {
  ALLOW
  LOG
  THROTTLE
  BLOCK
}

enum StudentStatus {
  ENROLLED
  IRREGULAR
  DROPPED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  // Two-factor (OTP) verification state. Both are nullable because they
  // are only ever populated between "password verified" and "OTP
  // verified or expired" - for the vast majority of the row's lifetime
  // (and for every non-admin account, which never enters the OTP step -
  // see controllers/authController.js) both stay null. otpCode is sized
  // for a zero-padded 6-digit numeric code (e.g. "004821"); it is stored
  // as plaintext rather than hashed because it is single-use, expires in
  // minutes (see OTP_TTL_MS in authController.js), and is always
  // immediately cleared on verification (success or expiry) - the
  // window in which a database compromise could reuse it is the same
  // short window in which it would have worked anyway.
  otpCode      String?   @map("otp_code") @db.VarChar(6)
  otpExpiresAt DateTime? @map("otp_expires_at")

  loginAttempts   LoginAttempt[]
  anomalyScores   AnomalyScore[]
  securityActions SecurityAction[]
  behaviorLogs    BehaviorLog[]
  sessions        Session[]
  student         Student?

  @@map("users")
}

model LoginAttempt {
  id          Int          @id @default(autoincrement())
  userEmail   String       @map("user_email") @db.VarChar(255)
  userId      Int?         @map("user_id")
  user        User?        @relation(fields: [userId], references: [id])
  ipAddress   String       @map("ip_address") @db.VarChar(45)
  status      LoginStatus?
  attemptTime DateTime     @default(now()) @map("attempt_time")

  @@index([userId])
  @@index([attemptTime])
  @@index([userEmail])
  @@map("login_attempts")
}

model AnomalyScore {
  id           Int        @id @default(autoincrement())
  userEmail    String     @map("user_email") @db.VarChar(255)
  userId       Int?       @map("user_id")
  user         User?      @relation(fields: [userId], references: [id])
  score        Decimal    @db.Decimal(5, 2)
  riskLevel    RiskLevel? @map("risk_level")
  calculatedAt DateTime   @default(now()) @map("calculated_at")

  @@index([userId])
  @@index([calculatedAt])
  @@map("anomaly_scores")
}

model SecurityAction {
  id          Int          @id @default(autoincrement())
  userEmail   String       @map("user_email") @db.VarChar(255)
  userId      Int?         @map("user_id")
  user        User?        @relation(fields: [userId], references: [id])
  actionTaken ActionTaken? @map("action_taken")
  reason      String?
  actionTime  DateTime     @default(now()) @map("action_time")

  @@index([userId])
  @@index([actionTime])
  @@map("security_actions")
}

model BehaviorLog {
  id          Int      @id @default(autoincrement())
  userEmail   String?  @map("user_email") @db.VarChar(255)
  userId      Int?     @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])
  eventType   String   @map("event_type") @db.VarChar(100)
  description String?
  logTime     DateTime @default(now()) @map("log_time")

  @@index([userId])
  @@index([logTime])
  @@map("behavior_logs")
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  user         User?    @relation(fields: [userId], references: [id])
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model IpTracking {
  id            Int       @id @default(autoincrement())
  ipAddress     String    @unique @map("ip_address") @db.VarChar(45)
  totalRequests Int       @default(0) @map("total_requests")
  isBlocked     Boolean   @default(false) @map("is_blocked")
  blockedUntil  DateTime? @map("blocked_until")
  lastSeen      DateTime  @default(now()) @map("last_seen")

  @@map("ip_tracking")
}

// ---------------------------------------------------------------------
// ACADEMIC RECORDS (basic models)
// ---------------------------------------------------------------------
// Student.userId links the registrar's record (student ID, name,
// program, standing) to the login account that owns it, backing the
// student dashboard's self-service "my profile / my grades" endpoint
// (GET /api/students/me in server.js). It is optional and unique:
// optional because a Student row can still exist with no matching
// login yet (there is no signup flow that provisions both at once),
// and unique because one login account may correspond to at most one
// student record.
model Student {
  id         Int           @id @default(autoincrement())
  studentId  String        @unique @map("student_id") @db.VarChar(20)
  fullName   String        @map("full_name") @db.VarChar(255)
  department String        @default("") @db.VarChar(100)
  program    String        @default("") @db.VarChar(150)
  yearLevel  String        @default("") @map("year_level") @db.VarChar(50)
  status     StudentStatus @default(ENROLLED)
  userId     Int?          @unique @map("user_id")
  user       User?         @relation(fields: [userId], references: [id])
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  grades Grade[]

  @@map("students")
}

model Subject {
  id           Int      @id @default(autoincrement())
  subjectCode  String   @unique @map("subject_code") @db.VarChar(20)
  subjectTitle String   @map("subject_title") @db.VarChar(255)
  units        Int      @default(3)
  department   String   @default("") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  grades Grade[]

  @@map("subjects")
}

model Grade {
  id        Int      @id @default(autoincrement())
  studentId Int      @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id])
  subjectId Int      @map("subject_id")
  subject   Subject  @relation(fields: [subjectId], references: [id])
  term      String?  @db.VarChar(50)

  // AES-256-GCM ciphertext envelope ("ivB64:authTagB64:cipherB64"), written
  // and read transparently by adapters/prisma/fieldEncryption.js's Prisma
  // Client Extension - every caller (server.js, prisma/seed.js) still
  // reads and writes `grade` as a plain numeric string, exactly as when
  // this column held a raw Decimal. Widened to VarChar(255) because the
  // envelope is longer than the 3-character grade it replaces -
  // @db.Decimal(3, 2) could never have stored it. Nothing in this app
  // filters, sorts, or aggregates on `grade` at the SQL level (GWA is
  // computed in JS from fetched rows - see server.js's /api/students/me),
  // so losing that ability by encrypting this column costs nothing here.
  grade     String?  @db.VarChar(255)

  remarks   String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, subjectId, term])
  @@index([studentId])
  @@index([subjectId])
  @@map("grades")
}